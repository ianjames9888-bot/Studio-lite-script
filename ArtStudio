-- Multi-Category Search Handler
local function performSearch()
    local query = SearchBox.Text
    if query == "" then return end

    SearchBtn.Text = "..."
    currentSearchResults = {}
    clearGrid()

    task.spawn(function()
        -- 1. Search Models
        pcall(function()
            local modelData = InsertService:GetFreeModelsAsync(query, 0)
            if modelData and modelData[1] and modelData[1].Results then
                for _, item in ipairs(modelData[1].Results) do
                    item.CustomCategory = "Models"
                    table.insert(currentSearchResults, item)
                end
            end
        end)

        -- 2. Search Decals
        pcall(function()
            local decalData = InsertService:GetFreeDecalsAsync(query, 0)
            if decalData and decalData[1] and decalData[1].Results then
                for _, item in ipairs(decalData[1].Results) do
                    item.CustomCategory = "Decals"
                    table.insert(currentSearchResults, item)
                end
            end
        end)

        -- 3. Search Audio via Catalog HTTP
        pcall(function()
            local url = "https://catalog.roblox.com/v1/search/items/details?category=Audio&keyword=" .. HttpService:UrlEncode(query) .. "&limit=10"
            local response = game:HttpGet(url)
            local json = HttpService:JSONDecode(response)
            if json and json.data then
                for _, item in ipairs(json.data) do
                    item.CustomCategory = "Audio"
                    table.insert(currentSearchResults, item)
                end
            end
        end)

        renderResults()
        SearchBtn.Text = "Search"
    end)
end

