local setClipboardFunc = setclipboard or toclipboard or set_clipboard or (syn and syn.write_clipboard)

local function copyId(assetId)
    if setClipboardFunc and assetId then
        setClipboardFunc(tostring(assetId))
    end
end

CopyActionBtn.MouseButton1Click:Connect(function()
    if selectedAssetId then
        copyId(selectedAssetId)
        CopyActionBtn.Text = "Copied!"
        CopyActionBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 70)
        task.wait(0.8)
        CopyActionBtn.Text = "Copy Asset ID"
        CopyActionBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 30)
    end
end)

local function inspectAsset(itemData)
    local assetId = itemData.AssetId or itemData.Id or itemData.id
    selectedAssetId = assetId
    
    DetailThumb.Image = "rbxthumb://type=Asset&id=" .. tostring(assetId) .. "&w=150&h=150"
    InfoName.Text = itemData.Name or itemData.name or "Unknown Asset"
    InfoDetails.Text = "Fetching info..."
    AudioPlayBtn.Visible = false

    if currentAudio then
        currentAudio:Stop()
        currentAudio:Destroy()
        currentAudio = nil
        AudioPlayBtn.Text = "▶ Play Audio"
    end

    task.spawn(function()
        local categoryName = itemData.CustomCategory or "Asset"
        local creatorName = itemData.CreatorName or "Unknown"
        local hasScripts = "No"

        local success, assetInfo = pcall(function()
            return MarketplaceService:GetProductInfo(assetId)
        end)

        if success and assetInfo then
            creatorName = assetInfo.Creator and assetInfo.Creator.Name or creatorName
            local assetTypeId = assetInfo.AssetTypeId
            
            if assetTypeId == 3 then
                categoryName = "Audio"
                AudioPlayBtn.Visible = true
            elseif assetTypeId == 10 or assetTypeId == 62 then
                categoryName = "Models"
                hasScripts = "Yes (Model)"
            elseif assetTypeId == 13 or assetTypeId == 1 then
                categoryName = "Decals"
            end
        end

        if categoryName == "Audio" then
            AudioPlayBtn.Visible = true
        end

        InfoDetails.Text = string.format("Type: %s | ID: %s\nOwner: %s\nContains Scripts: %s", categoryName, tostring(assetId), creatorName, hasScripts)
    end)
end

AudioPlayBtn.MouseButton1Click:Connect(function()
    if not selectedAssetId then return end

    if currentAudio and currentAudio.IsPlaying then
        currentAudio:Stop()
        currentAudio:Destroy()
        currentAudio = nil
        AudioPlayBtn.Text = "▶ Play Audio"
        AudioPlayBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    else
        if currentAudio then currentAudio:Destroy() end
        currentAudio = Instance.new("Sound")
        currentAudio.SoundId = "rbxassetid://" .. tostring(selectedAssetId)
        currentAudio.Volume = 1
        currentAudio.Parent = SoundService
        currentAudio:Play()

        AudioPlayBtn.Text = "⏸ Pause Audio"
        AudioPlayBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 30)

        currentAudio.Ended:Connect(function()
            AudioPlayBtn.Text = "▶ Play Audio"
            AudioPlayBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
            if currentAudio then
                currentAudio:Destroy()
                currentAudio = nil
            end
        end)
    end
end)

