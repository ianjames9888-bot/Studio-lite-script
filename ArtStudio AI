local httpRequest = (http and http.request) or (syn and syn.request) or request or http_request

local function fetchAIResponse(userPrompt)
	table.insert(ConversationHistory, {role = "user", content = userPrompt})

	local sendMessages = {}
	for _, item in ipairs(ConversationHistory) do
		table.insert(sendMessages, {
			role = item.role,
			content = item.content
		})
	end

	local payload = HttpService:JSONEncode({
		messages = sendMessages,
		model = "openai"
	})

	if httpRequest then
		for attempt = 1, 2 do
			local response = httpRequest({
				Url = POLLINATIONS_URL,
				Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = payload,
				Timeout = 30
			})
			if response and response.Body then
				local aiText = response.Body
				if aiText and aiText ~= "" then
					table.insert(ConversationHistory, {role = "assistant", content = aiText})
					
					local firstMsg = ConversationHistory[1] and ConversationHistory[1].content or "Chat"
					SavedSessions[CurrentSessionId] = {
						title = firstMsg:sub(1, 20) .. "...",
						history = ConversationHistory
					}
					saveCurrentData()
					updateSidebarUI()
					return true, aiText
				end
			end
			task.wait(1)
		end
	end
	table.remove(ConversationHistory, #ConversationHistory)
	return false, "Error: Could not resolve response from Pollinations AI. Please check network connection and retry."
end

handleSend = function(overrideText)
	if isWaitingForAI then return end
	local userPrompt = overrideText or TextBox.Text
	local fullPayloadText = userPrompt

	if StagedCodeText then
		fullPayloadText = (userPrompt ~= "" and (userPrompt .. "\n\n") or "") .. "```lua\n" .. StagedCodeText .. "\n```"
		StagedCodeText = nil
		isPreviewExpanded = false
		AttachCardToggle.Text = "▲ View"
		updateInputFramePos()
	end

	if fullPayloadText == "" or fullPayloadText:match("^%s*$") then return end

	setInputLock(true)
	if not overrideText then 
		TextBox.Text = ""
		InputFrame.Size = UDim2.new(1, -16, 0, 44)
		InputFrame.Position = UDim2.new(0, 8, 1, -52)
		updateInputFramePos()
	end

	if not overrideText then renderMessage("You", fullPayloadText) end
	local loadingWrapper = renderMessage("ArtStudio AI", "Thinking .")

	local thinkingThread = task.spawn(function()
		local count = 1
		local label = loadingWrapper:FindFirstChildOfClass("TextLabel")
		while isWaitingForAI do
			task.wait(0.4)
			count = (count % 3) + 1
			if label and label.Parent then
				label.Text = "<b>ArtStudio AI:</b> Thinking" .. string.rep(".", count)
			end
		end
	end)

	task.spawn(function()
		local success, responseText = fetchAIResponse(fullPayloadText)
		isWaitingForAI = false
		loadingWrapper:Destroy()
		if success then
			renderMessage("ArtStudio AI", responseText)
		else
			renderMessage("ArtStudio AI", responseText, true, fullPayloadText)
		end
		setInputLock(false)
	end)
end

