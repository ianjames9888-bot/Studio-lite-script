renderMessage = function(sender, rawText, isError, retryPrompt)
	local isUser = (sender == "You")
	local Wrapper = Instance.new("Frame")
	Wrapper.Size = UDim2.new(1, -10, 0, 0)
	Wrapper.BackgroundTransparency = 1
	Wrapper.Parent = ChatScroll

	local WrapperLayout = Instance.new("UIListLayout", Wrapper)
	WrapperLayout.SortOrder = Enum.SortOrder.LayoutOrder
	WrapperLayout.Padding = UDim.new(0, 6)

	local segments = {}
	local currentIdx = 1

	while currentIdx <= #rawText do
		local matchStart, matchEnd, codeContent = rawText:find("```%w*%s*(.-)```", currentIdx)
		if matchStart then
			if matchStart > currentIdx then
				table.insert(segments, {type = "text", content = rawText:sub(currentIdx, matchStart - 1)})
			end
			table.insert(segments, {type = "code", content = codeContent})
			currentIdx = matchEnd + 1
		else
			table.insert(segments, {type = "text", content = rawText:sub(currentIdx)})
			break
		end
	end

	for _, seg in ipairs(segments) do
		if seg.type == "text" and seg.content:gsub("%s+", "") ~= "" then
			local MsgLabel = Instance.new("TextLabel")
			MsgLabel.Size = UDim2.new(1, 0, 0, 0)
