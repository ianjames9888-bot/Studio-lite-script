local function loadSavedData()
	if readfile and isfile then
		if isfile(STORAGE_FILE) then
			pcall(function() SavedSessions = HttpService:JSONDecode(readfile(STORAGE_FILE)) end)
		end
		if isfile(SETTINGS_FILE) then
			pcall(function() SettingsData = HttpService:JSONDecode(readfile(SETTINGS_FILE)) end)
		end
	end
	if type(SavedSessions) ~= "table" then SavedSessions = {} end
	if type(SettingsData) ~= "table" then SettingsData = { HasSeenTutorial = false } end
end

local function saveCurrentData()
	if writefile then
		pcall(function() writefile(STORAGE_FILE, HttpService:JSONEncode(SavedSessions)) end)
		pcall(function() writefile(SETTINGS_FILE, HttpService:JSONEncode(SettingsData)) end)
	end
end
